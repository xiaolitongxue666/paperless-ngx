###############################################################################
# Paperless-ngx VPS env — copy to docker-compose.env（勿提交密钥）
# docs: https://docs.paperless-ngx.com/configuration/
###############################################################################

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

# Admin created on first start (change after login)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-strong-password

# Origin only — NO path. Public HTTPS domain (vps_nginx hybrid)
PAPERLESS_URL=https://xiaolitongxue.com.cn
# Optional: keep Tailscale login working too
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://xiaolitongxue.com.cn,http://100.74.201.82
PAPERLESS_ALLOWED_HOSTS=xiaolitongxue.com.cn,100.74.201.82,127.0.0.1,localhost

# Subpath behind vps_nginx /paperless/
PAPERLESS_FORCE_SCRIPT_NAME=/paperless
PAPERLESS_STATIC_URL=/paperless/static/

PAPERLESS_TIME_ZONE=Asia/Shanghai

# OCR language packs (chi_sim may be skipped if package missing)
PAPERLESS_OCR_LANGUAGES=eng chi_sim
PAPERLESS_OCR_LANGUAGE=eng

# Trusted proxy (host nginx)
PAPERLESS_TRUSTED_PROXIES=127.0.0.1

# Fast web PDF view (ghcr paperless-ngx v2.20 image API):
# - skip: don't OCR pages that already have text
# - SKIP_ARCHIVE=always: never build PDF/A archive (preview uses original)
# - OUTPUT_TYPE=pdf: avoid PDF/A when conversion does run
PAPERLESS_OCR_MODE=skip
PAPERLESS_OCR_SKIP_ARCHIVE_FILE=always
PAPERLESS_OCR_OUTPUT_TYPE=pdf
